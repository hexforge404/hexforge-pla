{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexforge.internal/pla/v2/device_status.schema.json",
  "title": "Device Status",
  "description": "HID executor health and safety state report (HID Executor → Brain)",
  "type": "object",
  "required": [
    "device_id",
    "timestamp",
    "boot_id",
    "sync_id",
    "status_sequence",
    "mode",
    "led_state",
    "kill_switch_state",
    "uptime_seconds"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique identifier for this HID executor (serial number or MAC)",
      "pattern": "^[a-zA-Z0-9_:-]+$",
      "minLength": 8,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "description": "Canonical UTC RFC3339 timestamp with millisecond precision, derived by firmware from the current Brain-authoritative time synchronization anchor. This does not replace Brain monotonic receive-age freshness.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "boot_id": {
      "type": "string",
      "description": "Fresh 128-bit identifier generated once for each MCU boot.",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sync_id": {
      "type": "string",
      "description": "Fresh 128-bit Brain-generated identifier for the current serial synchronization session.",
      "pattern": "^[0-9a-f]{32}$"
    },
    "status_sequence": {
      "type": "integer",
      "description": "Strictly increasing status sequence within the current boot and synchronization session, beginning at zero.",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "mode": {
      "type": "string",
      "description": "Current operating mode",
      "enum": ["OBSERVE", "SUGGEST", "EXECUTE"]
    },
    "led_state": {
      "type": "boolean",
      "description": "HID ARMED LED status (true=ON, false=OFF)"
    },
    "kill_switch_state": {
      "type": "string",
      "description": "Physical kill switch status",
      "enum": ["ARMED", "DISABLED", "UNKNOWN"]
    },
    "last_execution_time": {
      "type": "string",
      "description": "Optional: ISO 8601 timestamp of last HID action",
      "format": "date-time"
    },
    "error_state": {
      "type": "object",
      "description": "Optional: Current errors or warnings",
      "properties": {
        "has_error": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "NONE",
            "COMMAND_PARSE_ERROR",
            "BOUNDS_VIOLATION",
            "MODE_MISMATCH",
            "RATE_LIMIT_EXCEEDED",
            "USB_HID_FAILURE",
            "UNKNOWN_ERROR"
          ]
        },
        "error_message": {
          "type": "string",
          "maxLength": 500
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Errors since boot"
        }
      },
      "required": ["has_error", "error_code"]
    },
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds since HID executor boot"
    },
    "firmware_version": {
      "type": "string",
      "description": "Optional: Firmware version string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "action_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional: Total HID actions executed since boot"
    }
  },
  "additionalProperties": false
}
